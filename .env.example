# Mensajes historicos a traer por cada chat al iniciar.
# 0 = sin limite (trae todo el historial disponible del chat).
HISTORY_LIMIT=0

# Tiempo maximo (ms) para extraer el historial de un solo chat antes de
# saltarlo. Con HISTORY_LIMIT=0 los chats con mucho historial tardan mas.
CHAT_TIMEOUT_MS=300000
