{
	"name": "bot-wsp",
	"version": "1.0.0",
	"description": "Extractor de mensajes de WhatsApp con almacenamiento en DuckLake",
	"type": "module",
	"main": "app.js",
	"bin": "app.js",
	"scripts": {
		"start": "node app.js",
		"build:bundle": "node scripts/build-bundle.js",
		"build:assets": "node scripts/copy-assets.js",
		"build:exe": "node scripts/build-exe.js",
		"build": "npm run build:bundle && npm run build:assets && npm run build:exe",
		"lint": "biome lint --write src app.js",
		"format": "biome format --write src app.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@duckdb/node-api": "1.5.5-r.4",
		"dotenv": "^17.2.3",
		"p-queue": "^9.3.3",
		"pino": "^10.3.1",
		"pm2": "^6.0.14",
		"qrcode-terminal": "^0.12.0",
		"whatsapp-web.js": "^1.34.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@yao-pkg/pkg": "^6.22.0",
		"esbuild": "^0.28.2",
		"postject": "^1.0.0-alpha.6"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"puppeteer@24.38.0": true
	}
}
